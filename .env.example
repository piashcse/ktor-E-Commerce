# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ktor-ecom
DB_USER=postgres
DB_PASSWORD=change-me

# Server
PORT=8080
HOST=localhost

# JWT
JWT_SECRET=generate-a-secure-random-secret-at-least-256-bits-long
JWT_ISSUER=piashcse
JWT_AUDIENCE=ktor-ecommerce
JWT_REALM=ktor-ecommerce

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Emit HSTS only behind TLS termination
FORCE_HTTPS=false

# Pretty-print JSON responses (dev only)
JSON_PRETTY_PRINT=false

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Social login
GOOGLE_CLIENT_ID=

# TOTP secret encryption (falls back to JWT_SECRET in development)
MFA_ENCRYPTION_KEY=

# WebAuthn passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Ktor E-Commerce
WEBAUTHN_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads

# Payment provider: "manual" (COD only) or "stripe"
PAYMENT_PROVIDER=manual
# Required when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Shipping carrier: "manual" (seller-entered tracking) or "shippo"
SHIPPING_PROVIDER=manual
# Required when SHIPPING_PROVIDER=shippo
SHIPPO_API_TOKEN=
SHIPPO_BASE_URL=https://api.goshippo.com
# HMAC/shared secret for tracking webhooks
CARRIER_WEBHOOK_SECRET=

# Optional read replica (falls back to primary when unset)
# DB_READ_URL=jdbc:postgresql://replica-host:5432/ktor-ecommerce

# Database pool
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Proxy / network
# Only enable when the app is behind a trusted LB/CDN that sanitizes XFF.
TRUST_PROXY=false

# Metrics (leave empty to allow loopback only)
METRICS_TOKEN=

# SMTP SSL (STARTTLS is used when false)
EMAIL_SSL=false

# Require consent to all POLICY_TYPES before checkout (off by default)
REQUIRE_POLICY_CONSENT=false

# Multi-currency: reject FX rates older than this (0 disables the staleness check)
FX_MAX_AGE_HOURS=168

# Rate Limiting (format: limit:refillPeriodMinutes)
RATE_LIMIT_AUTH=5:10
RATE_LIMIT_OTP=10:10
RATE_LIMIT_REFRESH=10:10
RATE_LIMIT_WRITE=30:1
RATE_LIMIT_SEARCH=60:1
RATE_LIMIT_SELLER_WRITE=50:1
RATE_LIMIT_ADMIN_WRITE=100:1
RATE_LIMIT_GENERAL=100:1
